{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClaudeOS",
  "version": "1.0.0",
  "identifier": "com.claudeos.wolfAlpha",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5555"
  },
  "app": {
    "windows": [
      {
        "title": "WOLF ALPHA — ClaudeOS Command Center",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
