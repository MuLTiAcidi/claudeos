{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ClaudeOS",
  "version": "1.0.0",
  "identifier": "com.claudeos.wolfAlpha",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:5555"
  },
  "app": {
    "windows": [
      {
        "title": "WOLF ALPHA — ClaudeOS Command Center",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "ClaudeOS Wolf Alpha — AI Agent Command Center",
    "longDescription": "351 specialized AI agents working as one coordinated wolf pack. Visual command center with integrated Claude CLI terminal. Cyberpunk interface for bug bounty hunting, security research, and server management.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": null
    }
  }
}
